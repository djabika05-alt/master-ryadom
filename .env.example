# Development ONLY. Do not use local storage on Render.
# MEDIA_STORAGE=local
# MEDIA_DIR=./var/media
# DB_PATH=./var/master-ryadom.sqlite

# Production: private S3-compatible bucket, never a public bucket.
# Both application state and files are stored here, outside the Render filesystem.
MEDIA_STORAGE=s3
S3_ENDPOINT=https://YOUR-S3-ENDPOINT
S3_REGION=auto
S3_BUCKET=YOUR-PRIVATE-BUCKET
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=master-ryadom-test
# AWS S3 normally uses false; some compatible providers require true.
S3_FORCE_PATH_STYLE=false
